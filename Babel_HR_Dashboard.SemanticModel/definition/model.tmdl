model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Configuracion de conexion
queryGroup 'Data Source'

	annotation PBI_QueryGroupOrder = 0

/// Grupo con las tablas de dimensiones
queryGroup Dimensiones

	annotation PBI_QueryGroupOrder = 2

/// Grupo con las tablas hechos
queryGroup Hechos

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["HR_DataMart_Src","DimDepartamento","DimEmpleado","DimEscalaSalarial","DimFecha","DimHabilidad","DimMotivoSalida","DimPuesto","DimTipoAusencia","DimUbicacion","FactAusentismo","FactHabilidadEmpleado","FactHeadcountMensual","FactRotacion","_Medidas"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table HR_DataMart_Src
ref table DimDepartamento
ref table DimEmpleado
ref table DateTableTemplate_d2320952-bf16-4724-a6c7-581cc9385506
ref table LocalDateTable_71a820b3-0f67-48e1-9275-9c5bb10612f9
