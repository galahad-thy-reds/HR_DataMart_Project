table _Medidas
	lineageTag: 45b3434d-6ba0-4cc5-8b1c-6e12bafcf36b

	measure '01 - Días laborables mes' = 22
		formatString: 0
		lineageTag: 6a530a1e-1a5b-41f7-8975-72eaf3d23522

	measure '02 - Ultimo AnioMes' =
			
			CALCULATE (
			    MAX ( DimFecha[AnioMes] ),
			    FactHeadcountMensual[EsActivoN] = 1
			)
		lineageTag: 5a6ad79e-37e4-48f9-83ab-db6ce34ead64

	measure '03 - Headcount mes' =
			
			CALCULATE (
			    COUNTROWS ( FactHeadcountMensual ),
			    FactHeadcountMensual[EsActivoN] = 1
			)
		formatString: 0
		lineageTag: 34217a6a-553a-4cb5-831d-479ca8651849

	measure '04 - Headcount promedio' =
			
			AVERAGEX (
			    SUMMARIZE ( FactHeadcountMensual, DimFecha[AnioMes] ),
			    [03 - Headcount mes]
			)
		formatString: 0
		lineageTag: 1c6ad6f5-3b8d-4b2a-839e-01ccc8e56351

	measure '05 - Headcount actual' =
			
			VAR Periodo = [02 - Ultimo AnioMes]
			RETURN
			    CALCULATE (
			        [03 - Headcount mes],
			        FILTER ( ALL ( DimFecha[AnioMes] ), DimFecha[AnioMes] = Periodo )
			    )
		formatString: 0
		lineageTag: e0760e4a-d597-4210-83fa-8336825afef0

	measure '06 - Salidas' = ```
			SUM ( FactRotacion[ContadorSalida] )
			
			```
		formatString: 0
		lineageTag: a7bfb5a6-d884-4bf4-96af-c99a450c76a6

	measure '07 - Salidas evitables' =
			
