		formatString: 0
		lineageTag: 31fca951-0e45-45c7-b366-d7c6eb950882

	measure '08 - Tasa rotación %' = ```
			
			DIVIDE ( [06 - Salidas], [04 - Headcount promedio] )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 96289c70-f962-4c3d-8fbd-6caf040963f2

	measure '09 - % salidas evitables' =
			
