	column RangoAntiguedad =
			
			VAR m = FactRotacion[AntiguedadMeses]
			RETURN
			    SWITCH(
			        TRUE(),
			        m < 6, "0-6 meses",
			        m < 12, "6-12 meses",
			        m < 24, "1-2 años",
			        m < 48, "2-4 años",
			        "4+ años"
			    )
		lineageTag: 40f28e67-a6f2-4fbb-bb07-cbbbd1b42229
		summarizeBy: none
		sortByColumn: RangoAntiguedadOrden

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column RangoAntiguedadOrden =
			
			VAR Meses = FactRotacion[AntiguedadMeses]
			RETURN
			    SWITCH (
			        TRUE (),
			        Meses < 6, 1,
			        Meses < 12, 2,
			        Meses < 24, 3,
			        Meses < 48, 4,
			        5
			    )
		isHidden
		formatString: 0
		lineageTag: 25efffb9-a49d-4083-8b03-24cbd6d61bb5
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition FactRotacion = m
		mode: import
		queryGroup: Hechos
		source =
