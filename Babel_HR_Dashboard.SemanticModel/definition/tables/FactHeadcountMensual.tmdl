	column AntiguedadMeses
		dataType: int64
		formatString: 0
		lineageTag: 72dd05bc-e0cd-4bf0-acdb-f628a6dc9e2b
		summarizeBy: sum
		sourceColumn: AntiguedadMeses

		annotation SummarizationSetBy = Automatic

	column RangoAntiguedad =
			
			VAR Meses = FactHeadcountMensual[AntiguedadMeses]
			RETURN
			    SWITCH (
			        TRUE (),
			        Meses < 6, "0-6 meses",
			        Meses < 12, "6-12 meses",
			        Meses < 24, "1-2 años",
			        Meses < 48, "2-4 años",
			        "4+ años"
			    )
		lineageTag: 8ac45729-3821-4a55-984e-b09473cc8df6
		summarizeBy: none
		sortByColumn: RangoAntiguedadOrden

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column RangoAntiguedadOrden =
			
			VAR Meses = FactHeadcountMensual[AntiguedadMeses]
			RETURN
			    SWITCH (
			        TRUE (),
			        Meses < 6, 1,
			        Meses < 12, 2,
			        Meses < 24, 3,
			        Meses < 48, 4,
			        5
			    )
		isHidden
		formatString: 0
		lineageTag: 770652ce-9f24-4ee1-898c-c7434fd1bf89
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column PosicionEnBandaPct =
			
			DIVIDE (
			    FactHeadcountMensual[Salario] - RELATED ( DimEscalaSalarial[SalarioMinimo] ),
			    RELATED ( DimEscalaSalarial[SalarioMaximo] ) - RELATED ( DimEscalaSalarial[SalarioMinimo] )
			)
		lineageTag: 385e1e6d-50c3-4c55-a507-c8bfc0e2e1e1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column EstadoBanda = ```
			
			VAR Salario = FactHeadcountMensual[Salario]
			VAR Minimo = RELATED ( DimEscalaSalarial[SalarioMinimo] )
			VAR Maximo = RELATED ( DimEscalaSalarial[SalarioMaximo] )
			RETURN
			    SWITCH (
			        TRUE (),
			        Salario < Minimo, "Bajo banda",
			        Salario > Maximo, "Sobre banda",
			        "Dentro de banda"
			    )
			
			```
		lineageTag: b75d61a9-25b3-49a4-b66b-958c81a3c966
		summarizeBy: none
		sortByColumn: EstadoBandaOrden

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column EstadoBandaOrden =
			
			VAR Salario = FactHeadcountMensual[Salario]
			VAR Minimo = RELATED ( DimEscalaSalarial[SalarioMinimo] )
			VAR Maximo = RELATED ( DimEscalaSalarial[SalarioMaximo] )
			RETURN
			    SWITCH (
			        TRUE (),
			        Salario < Minimo, 1,
			        Salario > Maximo, 3,
			        2
			    )
		isHidden
		formatString: 0
		lineageTag: 7771042d-d0bf-4ccd-a362-b5170c973ef8
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column PosicionEnBandaBucket =
			
			VAR Pct = FactHeadcountMensual[PosicionEnBandaPct]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Pct ), "Sin banda",
			        Pct < 0, "< 0% (bajo banda)",
			        Pct < 0.20, "0-20%",
			        Pct < 0.40, "20-40%",
			        Pct < 0.60, "40-60%",
			        Pct < 0.80, "60-80%",
			        Pct <= 1, "80-100%",
			        "> 100% (sobre banda)"
			    )
		lineageTag: 1228d693-d13a-4191-87ee-e57d3de00f21
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column PosicionEnBandaBucketOrden =
			
			VAR Pct = FactHeadcountMensual[PosicionEnBandaPct]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Pct ), 0,
			        Pct < 0, 1,
			        Pct < 0.20, 2,
			        Pct < 0.40, 3,
			        Pct < 0.60, 4,
			        Pct < 0.80, 5,
			        Pct <= 1, 6,
			        7
			    )
		formatString: 0
		lineageTag: 90c210b0-325c-4d72-aaeb-e412e11507ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column EsActivoN = INT ( FactHeadcountMensual[EsActivo] )
		formatString: 0
		lineageTag: 8c3b26cc-0f9e-48c3-a441-1ad8aaaa7652
